rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function isAppOwner() {
      return isSignedIn() && userEmail() == 'info@granbertafilms.com';
    }

    function isAppAdmin() {
      return isSignedIn()
        && (
          isAppOwner()
          || (
            firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
          )
        );
    }

    function projectDoc(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)).data;
    }

    function collaboratorDoc(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)/collaborators/$(userEmail())).data;
    }

    function hasCollaboratorDoc(projectId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/projects/$(projectId)/collaborators/$(userEmail()));
    }

    function isProjectOwner(projectId) {
      return isSignedIn() && projectDoc(projectId).createdBy == request.auth.uid;
    }

    function isProjectCollaborator(projectId) {
      return isSignedIn()
        && (
          hasCollaboratorDoc(projectId)
          || userEmail() in projectDoc(projectId).collaboratorEmails
        );
    }

    function isProjectAdmin(projectId) {
      return isAppAdmin()
        || isProjectOwner(projectId)
        || (
          hasCollaboratorDoc(projectId)
          && collaboratorDoc(projectId).role == 'admin'
        );
    }

    function isProjectProductionLead(projectId) {
      return hasCollaboratorDoc(projectId)
        && collaboratorDoc(projectId).role == 'jefe_produccion';
    }

    function hasProjectAccess(projectId) {
      return isProjectAdmin(projectId) || isProjectCollaborator(projectId);
    }

    // Storage permits at most two distinct Firestore document reads per request.
    function canReadProjectFile(projectId) {
      return isSignedIn()
        && (
          isAppAdmin()
          || isProjectOwner(projectId)
          || (
            projectDoc(projectId).keys().hasAny(['collaboratorEmails'])
            && userEmail() in projectDoc(projectId).collaboratorEmails
          )
        );
    }

    function canWriteProjectDocument(projectId) {
      return isProjectAdmin(projectId)
        || (
          isProjectProductionLead(projectId)
          && 'documentos' in collaboratorDoc(projectId).allowedTabs
        );
    }

    function canWriteArea(projectId, area) {
      return (
          hasCollaboratorDoc(projectId)
          && collaboratorDoc(projectId).canEditBudgetAreas == true
          && area in collaboratorDoc(projectId).allowedCategories
          && 'areas' in collaboratorDoc(projectId).allowedTabs
        ) || isProjectAdmin(projectId);
    }

    function areaSubcategoryKey(area, subcategory) {
      return area + '||' + subcategory;
    }

    function canWriteAreaExpense(projectId, area, subcategory) {
      return (
          hasCollaboratorDoc(projectId)
          && collaboratorDoc(projectId).canEditBudgetAreas == true
          && 'areas' in collaboratorDoc(projectId).allowedTabs
          && subcategory is string
          && subcategory != ''
          && 'allowedSubcategories' in collaboratorDoc(projectId)
          && areaSubcategoryKey(area, subcategory) in collaboratorDoc(projectId).allowedSubcategories
        ) || canWriteArea(projectId, area);
    }

    function canWritePaymentReceipt(projectId, collectionName, itemId) {
      return (
          collectionName == 'areaExpenses'
          && firestore.exists(/databases/(default)/documents/projects/$(projectId)/areaExpenses/$(itemId))
          && canWriteAreaExpense(
            projectId,
            firestore.get(/databases/(default)/documents/projects/$(projectId)/areaExpenses/$(itemId)).data.area,
            firestore.get(/databases/(default)/documents/projects/$(projectId)/areaExpenses/$(itemId)).data.subcategory
          )
        ) || isProjectAdmin(projectId);
    }

    function invoiceMetadataMatchesExpense(projectId, collectionName, expenseId) {
      return (
          collectionName == 'budgetItems'
          && firestore.exists(/databases/(default)/documents/projects/$(projectId)/budgetItems/$(expenseId))
          && (
            (
              firestore.get(/databases/(default)/documents/projects/$(projectId)/budgetItems/$(expenseId)).data.keys().hasAny(['area'])
              && request.resource.metadata.area == firestore.get(/databases/(default)/documents/projects/$(projectId)/budgetItems/$(expenseId)).data.area
            )
            || (
              !firestore.get(/databases/(default)/documents/projects/$(projectId)/budgetItems/$(expenseId)).data.keys().hasAny(['area'])
              && request.resource.metadata.area == ''
            )
          )
        )
        || (
          collectionName == 'areaExpenses'
          && firestore.exists(/databases/(default)/documents/projects/$(projectId)/areaExpenses/$(expenseId))
          && (
            (
              firestore.get(/databases/(default)/documents/projects/$(projectId)/areaExpenses/$(expenseId)).data.keys().hasAny(['area'])
              && request.resource.metadata.area == firestore.get(/databases/(default)/documents/projects/$(projectId)/areaExpenses/$(expenseId)).data.area
            )
            || (
              !firestore.get(/databases/(default)/documents/projects/$(projectId)/areaExpenses/$(expenseId)).data.keys().hasAny(['area'])
              && request.resource.metadata.area == ''
            )
          )
        );
    }

    function canWriteInvoiceFromRequest(projectId, areaFolder) {
      return isSignedIn()
        && request.resource.metadata.projectId == projectId
        && (
          !request.resource.metadata.keys().hasAny(['areaFolder'])
          || request.resource.metadata.areaFolder == areaFolder
        )
        && request.resource.metadata.area is string
        && request.resource.metadata.collectionName in ['budgetItems', 'areaExpenses']
        && request.resource.metadata.expenseId is string
        && (
          // Metadata selects a route but never grants access by itself. Each
          // route independently verifies both the user and the expense.
          (request.resource.metadata.keys().hasAny(['uploadAccessScope']) && (
            (
              request.resource.metadata.uploadAccessScope == 'global_admin'
              && isAppAdmin()
              && invoiceMetadataMatchesExpense(projectId, request.resource.metadata.collectionName, request.resource.metadata.expenseId)
            )
            || (
              request.resource.metadata.uploadAccessScope == 'project_owner'
              && isProjectOwner(projectId)
              && invoiceMetadataMatchesExpense(projectId, request.resource.metadata.collectionName, request.resource.metadata.expenseId)
            )
            || (
              request.resource.metadata.uploadAccessScope == 'project_admin'
              && hasCollaboratorDoc(projectId)
              && collaboratorDoc(projectId).role == 'admin'
              && invoiceMetadataMatchesExpense(projectId, request.resource.metadata.collectionName, request.resource.metadata.expenseId)
            )
            || (
              request.resource.metadata.uploadAccessScope == 'area_editor'
              && request.resource.metadata.collectionName == 'areaExpenses'
              && firestore.exists(/databases/(default)/documents/projects/$(projectId)/areaExpenses/$(request.resource.metadata.expenseId))
              && hasCollaboratorDoc(projectId)
              && collaboratorDoc(projectId).canEditBudgetAreas == true
              && 'areas' in collaboratorDoc(projectId).allowedTabs
              && (
                request.resource.metadata.area in collaboratorDoc(projectId).allowedCategories
                || (
                  firestore.get(/databases/(default)/documents/projects/$(projectId)/areaExpenses/$(request.resource.metadata.expenseId)).data.keys().hasAny(['subcategory'])
                  && 'allowedSubcategories' in collaboratorDoc(projectId)
                  && firestore.get(/databases/(default)/documents/projects/$(projectId)/areaExpenses/$(request.resource.metadata.expenseId)).data.subcategory is string
                  && firestore.get(/databases/(default)/documents/projects/$(projectId)/areaExpenses/$(request.resource.metadata.expenseId)).data.subcategory != ''
                  && areaSubcategoryKey(
                    request.resource.metadata.area,
                    firestore.get(/databases/(default)/documents/projects/$(projectId)/areaExpenses/$(request.resource.metadata.expenseId)).data.subcategory
                  ) in collaboratorDoc(projectId).allowedSubcategories
                )
              )
              && invoiceMetadataMatchesExpense(projectId, 'areaExpenses', request.resource.metadata.expenseId)
            )
          ))
          || (
            // Existing cached clients retain their previous behavior.
            !request.resource.metadata.keys().hasAny(['uploadAccessScope'])
            && invoiceMetadataMatchesExpense(projectId, request.resource.metadata.collectionName, request.resource.metadata.expenseId)
            && canWritePaymentReceipt(projectId, request.resource.metadata.collectionName, request.resource.metadata.expenseId)
          )
        );
    }

    function publicInvoiceUploadInviteIsPending(projectId, areaFolder) {
      return request.auth == null
        && request.resource.metadata.token is string
        && (
          !request.resource.metadata.keys().hasAny(['areaFolder'])
          || request.resource.metadata.areaFolder == areaFolder
        )
        && firestore.exists(/databases/(default)/documents/invoiceUploadInvites/$(request.resource.metadata.token))
        && firestore.get(/databases/(default)/documents/invoiceUploadInvites/$(request.resource.metadata.token)).data.used == false
        && firestore.get(/databases/(default)/documents/invoiceUploadInvites/$(request.resource.metadata.token)).data.status == 'pending'
        && firestore.get(/databases/(default)/documents/invoiceUploadInvites/$(request.resource.metadata.token)).data.projectId == projectId
        && (
          !request.resource.metadata.keys().hasAny(['area'])
          || (
            firestore.get(/databases/(default)/documents/invoiceUploadInvites/$(request.resource.metadata.token)).data.keys().hasAny(['area'])
            && firestore.get(/databases/(default)/documents/invoiceUploadInvites/$(request.resource.metadata.token)).data.area == request.resource.metadata.area
          )
          || (
            !firestore.get(/databases/(default)/documents/invoiceUploadInvites/$(request.resource.metadata.token)).data.keys().hasAny(['area'])
            && request.resource.metadata.area == ''
          )
        )
        && firestore.get(/databases/(default)/documents/invoiceUploadInvites/$(request.resource.metadata.token)).data.expenseId == request.resource.metadata.expenseId
        && (
          (
            firestore.get(/databases/(default)/documents/invoiceUploadInvites/$(request.resource.metadata.token)).data.keys().hasAny(['collectionName'])
            && firestore.get(/databases/(default)/documents/invoiceUploadInvites/$(request.resource.metadata.token)).data.collectionName == request.resource.metadata.collectionName
          )
          || (
            !firestore.get(/databases/(default)/documents/invoiceUploadInvites/$(request.resource.metadata.token)).data.keys().hasAny(['collectionName'])
            && request.resource.metadata.collectionName == 'areaExpenses'
          )
        )
        && firestore.get(/databases/(default)/documents/invoiceUploadInvites/$(request.resource.metadata.token)).data.providerId == request.resource.metadata.providerId;
    }

    function publicInvoiceUploadInviteCanRead(projectId) {
      return request.auth == null
        && resource.metadata.token is string
        && firestore.exists(/databases/(default)/documents/invoiceUploadInvites/$(resource.metadata.token))
        && firestore.get(/databases/(default)/documents/invoiceUploadInvites/$(resource.metadata.token)).data.projectId == projectId;
    }

    match /projects/{projectId}/areas/{areaFolder}/facturas/{fileName} {
      allow read: if canReadProjectFile(projectId) || publicInvoiceUploadInviteCanRead(projectId);
      allow create: if (
          canWriteInvoiceFromRequest(projectId, areaFolder)
          || publicInvoiceUploadInviteIsPending(projectId, areaFolder)
        )
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png'];
      allow update, delete: if isProjectAdmin(projectId);
    }

    match /projects/{projectId}/{collectionName}/{itemId}/comprobantes/{fileName} {
      allow read: if hasProjectAccess(projectId);
      allow create: if canWritePaymentReceipt(projectId, collectionName, itemId)
        && collectionName in ['budgetItems', 'areaExpenses']
        && request.resource.size <= 2 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/webp'
        );
      allow update, delete: if isProjectAdmin(projectId);
    }

    match /projects/{projectId}/areaExpenses/{expenseId}/otros-comprobantes/{fileName} {
      allow read: if hasProjectAccess(projectId);
      allow create: if canWritePaymentReceipt(projectId, 'areaExpenses', expenseId)
        && request.resource.size <= 2 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/webp'
        );
      allow update, delete: if isProjectAdmin(projectId);
    }

    match /projects/{projectId}/documents/{documentId}/{fileName} {
      allow read: if hasProjectAccess(projectId);
      allow create, update: if canWriteProjectDocument(projectId)
        && request.resource.size <= 2 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'image/webp'
        );
      allow delete: if isProjectAdmin(projectId);
    }

    // Legacy path kept so previously uploaded invoices can still be managed.
    match /projects/{projectId}/areaExpenses/{expenseId}/{fileName} {
      allow read: if hasProjectAccess(projectId);
      allow create, update: if canWritePaymentReceipt(projectId, 'areaExpenses', expenseId)
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isProjectAdmin(projectId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
