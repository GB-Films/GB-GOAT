{
  "name": "gb-goat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit && npm run lint:rules",
    "lint:rules": "node scripts/validate-rules.mjs",
    "test": "tsx --test src/**/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-gb-goat-financial-rules \"node tests/financialRules.emulator.mjs\"",
    "test:provider-finance": "firebase emulators:exec --only firestore,storage --project demo-goat-provider-finance \"node tests/providerFinance.emulator.mjs\"",
    "test:area-access": "firebase emulators:exec --only firestore --project demo-goat-area-access \"node tests/areaExpenseAccessRules.emulator.mjs\"",
    "test:admin-rules": "firebase emulators:exec --only firestore --project demo-gb-goat-administration \"node tests/projectAdministrationRules.emulator.mjs\"",
    "test:admin-docs": "firebase emulators:exec --only firestore,storage --project demo-gb-goat-admin-documents \"node tests/administrativeDocumentsRules.emulator.mjs\"",
    "test:storage": "firebase emulators:exec --only firestore,storage --project demo-gb-goat-storage-receipts \"node tests/storagePaymentReceipts.emulator.mjs\"",
    "test:portal": "firebase emulators:exec --config firebase.portal-test.json --only firestore,storage,auth --project demo-goat-provider-portal \"node tests/providerPortal.emulator.mjs\"",
    "test:portal-rules": "node tests/runPortalRules.mjs"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@pdf-lib/fontkit": "1.1.1",
    "clsx": "^2.1.1",
    "exceljs": "4.4.0",
    "firebase": "^12.12.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
