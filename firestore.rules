rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function isAppOwner() {
      return isSignedIn() && userEmail() == 'info@granbertafilms.com';
    }

    function isAppAdmin() {
      return isSignedIn()
        && (
          isAppOwner()
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          )
        );
    }

    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function collaboratorDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)/collaborators/$(userEmail())).data;
    }

    function collaboratorDocByEmail(projectId, email) {
      return get(/databases/$(database)/documents/projects/$(projectId)/collaborators/$(email)).data;
    }

    function hasCollaboratorDoc(projectId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/projects/$(projectId)/collaborators/$(userEmail()));
    }

    function hasCollaboratorDocByEmail(projectId, email) {
      return email is string
        && exists(/databases/$(database)/documents/projects/$(projectId)/collaborators/$(email));
    }

    function isAppAdminRecipient(userId, email) {
      return email == 'info@granbertafilms.com'
        || (
          userId is string
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.role == 'admin'
          && get(/databases/$(database)/documents/users/$(userId)).data.email == email
        );
    }

    function isProjectOwner(projectId) {
      return isSignedIn() && projectDoc(projectId).createdBy == request.auth.uid;
    }

    function isProjectCollaborator(projectId) {
      return isSignedIn()
        && (
          hasCollaboratorDoc(projectId)
          || userEmail() in projectDoc(projectId).collaboratorEmails
        );
    }

    function isProjectAdmin(projectId) {
      return isAppAdmin()
        || isProjectOwner(projectId)
        || (
          hasCollaboratorDoc(projectId)
          && collaboratorDoc(projectId).role == 'admin'
        );
    }

    function isProjectProductionLead(projectId) {
      return hasCollaboratorDoc(projectId)
        && collaboratorDoc(projectId).role == 'jefe_produccion';
    }

    function hasProjectAccess(projectId) {
      return isProjectAdmin(projectId) || isProjectCollaborator(projectId);
    }

    function canWriteArea(projectId, area) {
      return isProjectAdmin(projectId)
        || (
          hasCollaboratorDoc(projectId)
          && collaboratorDoc(projectId).canEditBudgetAreas == true
          && area in collaboratorDoc(projectId).allowedCategories
          && 'areas' in collaboratorDoc(projectId).allowedTabs
        );
    }

    function areaSubcategoryKey(area, subcategory) {
      return area + '||' + subcategory;
    }

    function canWriteAreaExpense(projectId, area, subcategory) {
      return canWriteArea(projectId, area)
        || (
          hasCollaboratorDoc(projectId)
          && collaboratorDoc(projectId).canEditBudgetAreas == true
          && 'areas' in collaboratorDoc(projectId).allowedTabs
          && subcategory is string
          && subcategory != ''
          && 'allowedSubcategories' in collaboratorDoc(projectId)
          && areaSubcategoryKey(area, subcategory) in collaboratorDoc(projectId).allowedSubcategories
        );
    }

    function canAssignAreasAsProductionLead(projectId) {
      return isProjectProductionLead(projectId)
        && resource.data.role in ['jefe_produccion', 'jefe_area']
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowedCategories', 'allowedSubcategories', 'updatedAt'])
        && request.resource.data.allowedCategories is list
        && request.resource.data.allowedCategories.hasOnly(collaboratorDoc(projectId).allowedCategories)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['allowedSubcategories'])
          || (
            request.resource.data.allowedSubcategories is list
            && 'allowedSubcategories' in collaboratorDoc(projectId)
            && collaboratorDoc(projectId).allowedSubcategories is list
            && request.resource.data.allowedSubcategories.hasOnly(collaboratorDoc(projectId).allowedSubcategories)
          )
        );
    }

    function canAppendCollaboratorEmailAsProductionLead(projectId) {
      let oldCount = resource.data.collaboratorEmails.size();
      let newEmail = request.resource.data.collaboratorEmails[oldCount];
      let newCollaboratorPath = /databases/$(database)/documents/projects/$(projectId)/collaborators/$(newEmail);
      return isProjectProductionLead(projectId)
        && resource.data.collaboratorEmails is list
        && request.resource.data.collaboratorEmails is list
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaboratorEmails', 'updatedAt'])
        && request.resource.data.collaboratorEmails.size() == oldCount + 1
        && request.resource.data.collaboratorEmails.hasAll(resource.data.collaboratorEmails)
        && newEmail is string
        && existsAfter(newCollaboratorPath)
        && getAfter(newCollaboratorPath).data.role in ['jefe_produccion', 'jefe_area']
        && getAfter(newCollaboratorPath).data.allowedCategories is list
        && getAfter(newCollaboratorPath).data.allowedCategories.hasOnly(collaboratorDoc(projectId).allowedCategories);
    }

    function canUpdateProjectOperations(projectId) {
      return isProjectProductionLead(projectId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'shootingDate',
          'shootingStartDate',
          'shootingEndDate',
          'location',
          'updatedAt'
        ]);
    }

    function canUpdateAreaExpenseSubcategories(projectId) {
      return isProjectProductionLead(projectId)
        && collaboratorDoc(projectId).canEditBudgetAreas == true
        && 'areas' in collaboratorDoc(projectId).allowedTabs
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'areaExpenseSubcategories',
          'areaExpenseSubcategoryBudgets',
          'updatedAt'
        ]);
    }

    function canCreateCollaboratorAsProductionLead(projectId) {
      return isProjectProductionLead(projectId)
        && request.resource.data.role in ['jefe_produccion', 'jefe_area']
        && request.resource.data.allowedCategories is list
        && request.resource.data.allowedCategories.hasOnly(collaboratorDoc(projectId).allowedCategories)
        && (
          !request.resource.data.keys().hasAny(['allowedSubcategories'])
          || (
            request.resource.data.allowedSubcategories is list
            && 'allowedSubcategories' in collaboratorDoc(projectId)
            && collaboratorDoc(projectId).allowedSubcategories is list
            && request.resource.data.allowedSubcategories.hasOnly(collaboratorDoc(projectId).allowedSubcategories)
          )
        );
    }

    function collaboratorIdentityIsValid(email) {
      return request.resource.data.email == email
        && request.resource.data.uid is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.uid))
        && get(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.email == email;
    }

    function canWriteProjectDocument(projectId) {
      return isProjectAdmin(projectId)
        || (
          isProjectProductionLead(projectId)
          && 'documentos' in collaboratorDoc(projectId).allowedTabs
        );
    }

    function isAppProductionLead() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'jefe_produccion';
    }

    function isAppAdminAssistant() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ayudante_admin';
    }

    function canCreateGlobalProvider() {
      return isAppAdmin() || isAppProductionLead() || isAppAdminAssistant();
    }

    function canEditGlobalProvider() {
      return isAppAdmin() || isAppAdminAssistant();
    }

    function storedPaymentCount() {
      return resource.data.keys().hasAny(['paymentHistory'])
        && resource.data.paymentHistory is list
        ? resource.data.paymentHistory.size()
        : 0;
    }

    function hasReceivedPayment() {
      return (resource.data.keys().hasAny(['paymentLocked']) && resource.data.paymentLocked == true)
        || storedPaymentCount() > 0;
    }

    function validPaymentAuditAppend() {
      let oldCount = storedPaymentCount();
      let oldAuthorIds = resource.data.keys().hasAny(['paymentAuthorIds'])
        && resource.data.paymentAuthorIds is list
        ? resource.data.paymentAuthorIds
        : [];
      return request.resource.data.keys().hasAll(['paymentHistory', 'paymentLocked', 'paymentAuthorIds'])
        && request.resource.data.paymentHistory is list
        && request.resource.data.paymentAuthorIds is list
        && request.resource.data.paymentLocked == true
        && request.resource.data.paymentHistory.size() == oldCount + 1
        && (oldCount == 0 || request.resource.data.paymentHistory.hasAll(resource.data.paymentHistory))
        && request.resource.data.paymentHistory[oldCount].createdBy == request.auth.uid
        && request.resource.data.paymentHistory[oldCount].createdByEmail == userEmail()
        && request.resource.data.paymentHistory[oldCount].amount is number
        && request.resource.data.paymentHistory[oldCount].amount > 0
        && request.resource.data.paymentAuthorIds.size() == oldAuthorIds.size() + 1
        && request.resource.data.paymentAuthorIds.hasAll(oldAuthorIds)
        && request.resource.data.paymentAuthorIds[oldAuthorIds.size()] == request.auth.uid;
    }

    function preservesExpensePaymentAudit() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['createdBy', 'createdByEmail'])
        && (
          !changed.hasAny(['paymentHistory', 'paymentLocked', 'paymentAuthorIds'])
          || validPaymentAuditAppend()
        );
    }

    function preservesExpenseReceipts() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldReceipts = resource.data.keys().hasAny(['otherReceipts'])
        && resource.data.otherReceipts is list
        ? resource.data.otherReceipts
        : [];
      return !changed.hasAny(['otherReceipts'])
        || (
          request.resource.data.otherReceipts is list
          && request.resource.data.otherReceipts.size() == oldReceipts.size() + 1
          && request.resource.data.otherReceipts.hasAll(oldReceipts)
          && request.resource.data.otherReceipts[oldReceipts.size()].uploadedByEmail == userEmail()
        );
    }

    function validExpenseInvoice(invoice) {
      return invoice is map
        && invoice.fileName is string
        && invoice.originalFileName is string
        && invoice.url is string
        && invoice.path is string
        && invoice.contentType in ['application/pdf', 'image/jpeg', 'image/png']
        && invoice.size is number
        && invoice.size <= 2 * 1024 * 1024;
    }

    function preservesExistingExpenseInvoice() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let hadInvoice = resource.data.keys().hasAny(['invoice']) && resource.data.invoice != null;
      let oldInvoices = resource.data.keys().hasAny(['invoices']) && resource.data.invoices is list
        ? resource.data.invoices
        : [];
      let requestedInvoices = request.resource.data.keys().hasAny(['invoices']) && request.resource.data.invoices is list
        ? request.resource.data.invoices
        : [];
      let nextInvoice = requestedInvoices.size() > oldInvoices.size()
        ? requestedInvoices[oldInvoices.size()]
        : null;
      return !changed.hasAny(['invoice', 'invoices', 'invoiceStatus'])
        || (
          request.resource.data.invoices is list
          && request.resource.data.invoices.size() == oldInvoices.size() + 1
          && request.resource.data.invoices.hasAll(oldInvoices)
          && validExpenseInvoice(nextInvoice)
          && request.resource.data.invoiceStatus == 'pendiente'
          && (
            (hadInvoice && request.resource.data.invoice == resource.data.invoice)
            || (
              !hadInvoice
              && (
                (oldInvoices.size() == 0 && request.resource.data.invoice == nextInvoice)
                || (oldInvoices.size() > 0 && !request.resource.data.keys().hasAny(['invoice']))
              )
            )
          )
        );
    }

    function canDeleteAreaExpenseWithPayment(projectId) {
      return canWriteAreaExpense(projectId, resource.data.area, resource.data.subcategory)
        && (
          !hasReceivedPayment()
          || isProjectAdmin(projectId)
        );
    }

    function cashMovementBaseIsValid() {
      return request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.date is timestamp;
    }

    function canCreateCashMovement(projectId) {
      return cashMovementBaseIsValid()
        && (
          (
            isProjectAdmin(projectId)
            && request.resource.data.type == 'entrega'
            && request.resource.data.status == 'pending'
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdByEmail == userEmail()
            && (
              (
                hasCollaboratorDocByEmail(projectId, request.resource.data.toUserEmail)
                && collaboratorDocByEmail(projectId, request.resource.data.toUserEmail).role in ['admin', 'jefe_produccion', 'jefe_area']
              )
              || (
                request.resource.data.keys().hasAll(['toUserId'])
                && isAppAdminRecipient(request.resource.data.toUserId, request.resource.data.toUserEmail)
              )
              || isAppAdminRecipient('', request.resource.data.toUserEmail)
            )
          )
          || (
            isProjectProductionLead(projectId)
            && request.resource.data.type == 'transferencia'
            && request.resource.data.fromUserEmail == userEmail()
            && hasCollaboratorDocByEmail(projectId, request.resource.data.toUserEmail)
            && collaboratorDocByEmail(projectId, request.resource.data.toUserEmail).role == 'jefe_area'
            && collaboratorDocByEmail(projectId, request.resource.data.toUserEmail).allowedCategories.hasAny(collaboratorDoc(projectId).allowedCategories)
          )
          || (
            request.resource.data.type == 'pago'
            && request.resource.data.fromUserEmail == userEmail()
            && request.resource.data.collectionName in ['budgetItems', 'areaExpenses']
            && canWriteAreaExpense(projectId, request.resource.data.area, request.resource.data.subcategory)
            && (
              !request.resource.data.keys().hasAny(['cashAccount'])
              || request.resource.data.cashAccount == 'personal'
              || (request.resource.data.cashAccount == 'general' && isProjectAdmin(projectId))
            )
          )
        );
    }

    function canDeleteCashMovement(projectId) {
      return isProjectAdmin(projectId);
    }

    function canUpdateCashMovement(projectId) {
      return cashMovementBaseIsValid()
        && (
          (
            resource.data.type == 'entrega'
            && resource.data.status == 'pending'
            && resource.data.toUserEmail == userEmail()
            && request.resource.data.type == resource.data.type
            && request.resource.data.status == 'confirmed'
            && request.resource.data.confirmedBy == request.auth.uid
            && request.resource.data.confirmedByEmail == userEmail()
            && request.resource.data.confirmedByName is string
            && request.resource.data.confirmedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'confirmedAt',
              'confirmedBy',
              'confirmedByEmail',
              'confirmedByName',
              'updatedAt'
            ])
          )
          || (
            resource.data.type == 'entrega'
            && request.resource.data.type == resource.data.type
            && (!resource.data.keys().hasAny(['status']) || resource.data.status == 'pending')
            && (isProjectAdmin(projectId) || resource.data.createdByEmail == userEmail())
            && request.resource.data.createdByEmail == resource.data.createdByEmail
            && request.resource.data.toUserEmail == resource.data.toUserEmail
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'date', 'notes', 'updatedAt'])
          )
          || (
            resource.data.type == 'pago'
            && request.resource.data.type == resource.data.type
            && isProjectAdmin(projectId)
            && request.resource.data.fromUserEmail == resource.data.fromUserEmail
            && request.resource.data.collectionName == resource.data.collectionName
            && request.resource.data.itemId == resource.data.itemId
            && request.resource.data.paymentId == resource.data.paymentId
            && request.resource.data.area == resource.data.area
            && canWriteAreaExpense(projectId, resource.data.area, resource.data.subcategory)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'date', 'notes', 'updatedAt'])
          )
        );
    }

    function inviteIsPending(token) {
      return token is string
        && exists(/databases/$(database)/documents/providerInvites/$(token))
        && get(/databases/$(database)/documents/providerInvites/$(token)).data.used == false
        && get(/databases/$(database)/documents/providerInvites/$(token)).data.status == 'pending'
        && providerInviteNotExpired(token);
    }

    function invoiceUploadInviteIsPending(token, projectId, collectionName, expenseId) {
      return request.auth == null
        && token is string
        && exists(/databases/$(database)/documents/invoiceUploadInvites/$(token))
        && get(/databases/$(database)/documents/invoiceUploadInvites/$(token)).data.used == false
        && get(/databases/$(database)/documents/invoiceUploadInvites/$(token)).data.status == 'pending'
        && get(/databases/$(database)/documents/invoiceUploadInvites/$(token)).data.projectId == projectId
        && (
          (
            get(/databases/$(database)/documents/invoiceUploadInvites/$(token)).data.keys().hasAny(['collectionName'])
            && get(/databases/$(database)/documents/invoiceUploadInvites/$(token)).data.collectionName == collectionName
          )
          || (
            !get(/databases/$(database)/documents/invoiceUploadInvites/$(token)).data.keys().hasAny(['collectionName'])
            && collectionName == 'areaExpenses'
          )
        )
        && get(/databases/$(database)/documents/invoiceUploadInvites/$(token)).data.expenseId == expenseId;
    }

    function validProviderInviteExpiration() {
      return request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');
    }

    function providerInviteNotExpired(token) {
      return !get(/databases/$(database)/documents/providerInvites/$(token)).data.keys().hasAny(['expiresAt'])
        || get(/databases/$(database)/documents/providerInvites/$(token)).data.expiresAt > request.time;
    }

    function canPublicUploadInvoice(projectId, collectionName, expenseId) {
      let oldInvoices = resource.data.keys().hasAny(['invoices']) && resource.data.invoices is list
        ? resource.data.invoices
        : [];
      let requestedInvoices = request.resource.data.keys().hasAny(['invoices']) && request.resource.data.invoices is list
        ? request.resource.data.invoices
        : [];
      let nextInvoice = requestedInvoices.size() > oldInvoices.size()
        ? requestedInvoices[oldInvoices.size()]
        : null;
      let hadInvoice = resource.data.keys().hasAny(['invoice']) && resource.data.invoice != null;
      return request.auth == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invoice', 'invoices', 'invoiceStatus', 'publicInvoiceUpload', 'updatedAt'])
        && request.resource.data.invoices is list
        && request.resource.data.invoices.size() == oldInvoices.size() + 1
        && request.resource.data.invoices.hasAll(oldInvoices)
        && request.resource.data.invoiceStatus == 'pendiente'
        && validExpenseInvoice(nextInvoice)
        && nextInvoice.uploadedBy == 'provider_public_link'
        && (
          (hadInvoice && request.resource.data.invoice == resource.data.invoice)
          || (!hadInvoice && !request.resource.data.keys().hasAny(['invoice']))
        )
        && request.resource.data.publicInvoiceUpload.token is string
        && invoiceUploadInviteIsPending(request.resource.data.publicInvoiceUpload.token, projectId, collectionName, expenseId);
    }

    function publicProviderCreateIsValid() {
      return request.resource.data.source == 'provider_invite'
        && inviteIsPending(request.resource.data.inviteToken)
        && request.resource.data.type in ['persona', 'empresa']
        && request.resource.data.cuitNormalized is string
        && request.resource.data.category is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.bankAccount_cbu is string
        && request.resource.data.bankAccount_alias is string
        && (
          request.resource.data.bankAccount_cbu.matches('^[0-9]{22}$')
          || (
            request.resource.data.bankAccount_cbu == ''
            && request.resource.data.bankAccount_alias.size() > 0
          )
        );
    }

    function canCreateLinkedProviderInvite() {
      return isSignedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.used == false
        && validProviderInviteExpiration()
        && request.resource.data.projectId is string
        && request.resource.data.expenseId is string
        && request.resource.data.collectionName in ['budgetItems', 'areaExpenses']
        && request.resource.data.area is string
        && (
          (
            request.resource.data.collectionName == 'areaExpenses'
            && canWriteAreaExpense(request.resource.data.projectId, request.resource.data.area, request.resource.data.subcategory)
          )
          || (
            request.resource.data.collectionName == 'budgetItems'
            && isProjectAdmin(request.resource.data.projectId)
          )
        );
    }

    function canCancelLinkedProviderInvite() {
      return isSignedIn()
        && resource.data.projectId is string
        && resource.data.collectionName in ['budgetItems', 'areaExpenses']
        && resource.data.area is string
        && (
          (
            resource.data.collectionName == 'areaExpenses'
            && canWriteAreaExpense(resource.data.projectId, resource.data.area, resource.data.subcategory)
          )
          || (
            resource.data.collectionName == 'budgetItems'
            && isProjectAdmin(resource.data.projectId)
          )
        );
    }

    function providerInviteTargetsItem(projectId, collectionName, itemId, token) {
      return token is string
        && exists(/databases/$(database)/documents/providerInvites/$(token))
        && get(/databases/$(database)/documents/providerInvites/$(token)).data.used == false
        && get(/databases/$(database)/documents/providerInvites/$(token)).data.status == 'pending'
        && providerInviteNotExpired(token)
        && get(/databases/$(database)/documents/providerInvites/$(token)).data.projectId == projectId
        && get(/databases/$(database)/documents/providerInvites/$(token)).data.collectionName == collectionName
        && get(/databases/$(database)/documents/providerInvites/$(token)).data.expenseId == itemId;
    }

    function canPublicAssignProviderFromInvite(projectId, collectionName, itemId) {
      return (!resource.data.keys().hasAny(['providerId']) || resource.data.providerId == '')
        && (!resource.data.keys().hasAny(['providerName']) || resource.data.providerName == '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['providerId', 'providerName', 'providerInviteAssignment', 'updatedAt'])
        && request.resource.data.providerId is string
        && request.resource.data.providerName is string
        && request.resource.data.providerInviteAssignment.token is string
        && request.resource.data.providerInviteAssignment.providerId == request.resource.data.providerId
        && providerInviteTargetsItem(projectId, collectionName, itemId, request.resource.data.providerInviteAssignment.token);
    }

    function userInviteIsPending(token) {
      return token is string
        && exists(/databases/$(database)/documents/userInvites/$(token))
        && get(/databases/$(database)/documents/userInvites/$(token)).data.used == false
        && get(/databases/$(database)/documents/userInvites/$(token)).data.status == 'pending';
    }

    function userInviteMatchesSignedInEmail(token) {
      return userInviteIsPending(token)
        && get(/databases/$(database)/documents/userInvites/$(token)).data.email == userEmail();
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (
        isAppOwner()
        || (
          request.auth.uid == userId
          && request.resource.data.role == 'colaborador'
          && request.resource.data.inviteToken is string
          && userInviteMatchesSignedInEmail(request.resource.data.inviteToken)
        )
      );
      allow update: if isAppOwner()
        || (
          isAppAdmin()
          && resource.data.email != 'info@granbertafilms.com'
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && resource.data.role in ['colaborador', 'jefe_produccion', 'ayudante_admin']
          && request.resource.data.role in ['colaborador', 'jefe_produccion', 'ayudante_admin']
        )
        || (
          isSignedIn()
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        );
      allow delete: if isAppOwner();
    }

    match /userInvites/{token} {
      allow get: if isAppAdmin() || (
        isSignedIn()
        && resource.data.email == userEmail()
      );
      allow list: if isAppAdmin();
      allow create: if isAppAdmin()
        && request.resource.data.email is string
        && request.resource.data.status == 'pending'
        && request.resource.data.used == false;
      allow update: if isAppAdmin()
        || (
          isSignedIn()
          && resource.data.email == userEmail()
          && resource.data.status == 'pending'
          && resource.data.used == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'used', 'usedAt', 'usedBy', 'usedByEmail'])
          && request.resource.data.status == 'used'
          && request.resource.data.used == true
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.usedByEmail == userEmail()
        );
      allow delete: if isAppAdmin();
    }

    // The user directory is readable by signed-in users so project admins can add
    // already-logged collaborators without giving them global admin privileges.

    match /projects/{projectId} {
      allow list: if isAppAdmin() || (
        isSignedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || userEmail() in resource.data.collaboratorEmails
        )
      );
      allow get: if hasProjectAccess(projectId);
      allow create: if isAppAdmin() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isProjectAdmin(projectId)
        || canAppendCollaboratorEmailAsProductionLead(projectId)
        || canUpdateProjectOperations(projectId)
        || canUpdateAreaExpenseSubcategories(projectId);
      allow delete: if isAppAdmin();

      match /collaborators/{email} {
        allow read: if hasProjectAccess(projectId);
        allow create: if collaboratorIdentityIsValid(email)
          && (isProjectAdmin(projectId) || canCreateCollaboratorAsProductionLead(projectId));
        allow delete: if isProjectAdmin(projectId);
        allow update: if isProjectAdmin(projectId) || canAssignAreasAsProductionLead(projectId);
      }

      match /budgetItems/{itemId} {
        allow read: if hasProjectAccess(projectId);
        allow create, delete: if isProjectAdmin(projectId);
        allow update: if isProjectAdmin(projectId)
          || canPublicAssignProviderFromInvite(projectId, 'budgetItems', itemId)
          || canPublicUploadInvoice(projectId, 'budgetItems', itemId);
      }

      match /areaExpenses/{expenseId} {
        allow read: if hasProjectAccess(projectId);
        allow create: if isProjectAdmin(projectId)
          || (
            canWriteAreaExpense(projectId, request.resource.data.area, request.resource.data.subcategory)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdByEmail is string
            && request.resource.data.paymentHistory == []
            && request.resource.data.paymentLocked == false
            && request.resource.data.paymentAuthorIds == []
          );
        allow update: if isProjectAdmin(projectId)
          || ((
            canWriteAreaExpense(projectId, resource.data.area, resource.data.subcategory)
            && canWriteAreaExpense(projectId, request.resource.data.area, request.resource.data.subcategory)
          ) && preservesExpensePaymentAudit() && preservesExpenseReceipts() && preservesExistingExpenseInvoice())
          || canPublicAssignProviderFromInvite(projectId, 'areaExpenses', expenseId)
          || canPublicUploadInvoice(projectId, 'areaExpenses', expenseId);
        allow delete: if canDeleteAreaExpenseWithPayment(projectId);
      }

      match /expenses/{expenseId} {
        allow read: if hasProjectAccess(projectId);
        allow write: if isProjectAdmin(projectId);
      }

      match /milestones/{milestoneId} {
        allow read: if hasProjectAccess(projectId);
        allow write: if isProjectAdmin(projectId);
      }

      match /teamMembers/{memberId} {
        allow read: if hasProjectAccess(projectId);
        allow write: if isProjectAdmin(projectId);
      }

      match /payments/{paymentId} {
        allow read: if hasProjectAccess(projectId);
        allow write: if isProjectAdmin(projectId);
      }

      match /invoices/{invoiceId} {
        allow read: if hasProjectAccess(projectId);
        allow write: if isProjectAdmin(projectId);
      }

      match /projectDocuments/{documentId} {
        allow read: if hasProjectAccess(projectId);
        allow create: if canWriteProjectDocument(projectId);
        allow update, delete: if isProjectAdmin(projectId);
      }

      match /activityLog/{entryId} {
        allow read: if isProjectAdmin(projectId);
        allow create: if hasProjectAccess(projectId)
          && request.resource.data.keys().hasAll([
            'action',
            'deletedBy',
            'deletedByEmail',
            'deletedByName',
            'deletedByRole',
            'createdAt'
          ])
          && request.resource.data.action in [
            'expense_rows_deleted',
            'payment_deleted',
            'cash_delivery_deleted'
          ]
          && request.resource.data.deletedBy == request.auth.uid
          && request.resource.data.deletedByEmail == userEmail()
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAppAdmin();
      }

      match /cashMovements/{movementId} {
        allow read: if hasProjectAccess(projectId);
        allow create: if canCreateCashMovement(projectId);
        allow update: if canUpdateCashMovement(projectId);
        allow delete: if canDeleteCashMovement(projectId);
      }
    }

    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isAppAdmin();
    }

    match /providers/{providerId} {
      allow read: if isSignedIn();
      allow create: if canCreateGlobalProvider() || publicProviderCreateIsValid();
      allow update: if canEditGlobalProvider();
      allow delete: if isAppAdmin();
    }

    match /providerInvites/{token} {
      allow get: if true;
      allow list: if canCreateGlobalProvider();
      allow create: if (canCreateGlobalProvider() || canCreateLinkedProviderInvite())
        && request.resource.data.status == 'pending'
        && request.resource.data.used == false
        && validProviderInviteExpiration();
      allow update: if isAppAdmin()
        || (
          (canCreateGlobalProvider() || canCancelLinkedProviderInvite())
          && resource.data.used == false
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy', 'cancelledByEmail', 'updatedAt'])
          && request.resource.data.status == 'cancelled'
        )
        || (
          resource.data.used == false
          && resource.data.status == 'pending'
          && providerInviteNotExpired(token)
          && (!resource.data.keys().hasAny(['mode']) || resource.data.mode != 'multi_use')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'status', 'usedAt', 'providerId', 'providerType'])
          && request.resource.data.used == true
          && request.resource.data.status == 'used'
          && request.resource.data.providerId is string
          && request.resource.data.providerType in ['persona', 'empresa']
        )
        || (
          resource.data.used == false
          && resource.data.status == 'pending'
          && resource.data.mode == 'multi_use'
          && providerInviteNotExpired(token)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount', 'lastUsedAt', 'lastProviderId', 'lastProviderType', 'updatedAt'])
          && request.resource.data.usageCount is number
          && request.resource.data.usageCount >= resource.data.usageCount
          && request.resource.data.lastProviderId is string
          && request.resource.data.lastProviderType in ['persona', 'empresa']
        );
      allow delete: if isAppAdmin();
    }

    match /providerIdentifiers/{identifierId} {
      allow get: if true;
      allow list: if isAppAdmin();
      allow create: if canCreateGlobalProvider()
        || (
          request.resource.data.inviteToken is string
          && inviteIsPending(request.resource.data.inviteToken)
          && request.resource.data.providerId is string
          && request.resource.data.identifierType in ['dni', 'cuit']
          && request.resource.data.value is string
        );
      allow update, delete: if canEditGlobalProvider();
    }

    match /invoiceUploadInvites/{token} {
      allow get: if true;
      allow list: if canCreateGlobalProvider();
      allow create: if isSignedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.used == false
        && request.resource.data.projectId is string
        && request.resource.data.expenseId is string
        && request.resource.data.collectionName in ['budgetItems', 'areaExpenses']
        && request.resource.data.area is string
        && (
          (
            request.resource.data.collectionName == 'areaExpenses'
            && canWriteAreaExpense(
              request.resource.data.projectId,
              request.resource.data.area,
              request.resource.data.subcategory
            )
          )
          || (
            request.resource.data.collectionName == 'budgetItems'
            && isProjectAdmin(request.resource.data.projectId)
          )
        );
      allow update: if isAppAdmin()
        || (
          request.auth == null
          && resource.data.used == false
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'status', 'usedAt', 'invoiceFileName', 'invoicePath', 'invoiceUrl', 'originalFileName'])
          && request.resource.data.used == true
          && request.resource.data.status == 'used'
          && request.resource.data.invoicePath is string
          && request.resource.data.invoiceUrl is string
        );
      allow delete: if isAppAdmin();
    }
  }
}
